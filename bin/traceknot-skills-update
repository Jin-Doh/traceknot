#!/bin/sh
# Secure automatic-update bridge for Skills CLI-owned Traceknot registrations.

set -eu

PROGRAM=traceknot-skills-update
REPOSITORY=Jin-Doh/traceknot
API_URL=https://api.github.com/repos/$REPOSITORY/releases
SIGNER_WORKFLOW=Jin-Doh/traceknot/.github/workflows/release.yml
SKILLS_CLI_VERSION=1.5.22
MIN_AGE=604800
CHECK_INTERVAL=86400

COMMAND=check
SCOPE=
PROJECT_ROOT=
DRY_RUN=0
AUTO_INVOCATION=0
TMP_ROOT=
LOCK_HELD=0
RECOVERY_LOCK_HELD=0
LOCK_CLAIM=

fail() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 2
}

usage() {
    cat <<EOF_USAGE
Usage: $PROGRAM COMMAND (--global | --project DIR) [--dry-run]

Commands:
  check                 observe releases and report eligibility
  apply                 install the newest eligible verified release
  enable                install the daily automatic-update schedule
  disable               remove the automatic-update schedule
  status                show policy and installed update state

Scope:
  --global              manage \$HOME/.agents/skills/traceknot
  --project DIR         manage DIR/.agents/skills/traceknot

Options:
  --dry-run, -n         show an eligible update without changing the Skill
  --auto                scheduled invocation; no-op unless enabled
  --help, -h            show this help

A candidate must be immutable and observed for strictly more than seven days.
Application verifies the release artifact, preflights the exact source commit,
and delegates the final registration write to Skills CLI $SKILLS_CLI_VERSION.
EOF_USAGE
}

canonical_path() {
    canonical_input=$1
    case "$canonical_input" in /*) ;; *) return 1 ;; esac
    if [ -d "$canonical_input" ]; then
        (CDPATH='' cd -P "$canonical_input" && pwd)
        return
    fi
    canonical_parent=$(dirname "$canonical_input")
    canonical_name=$(basename "$canonical_input")
    canonical_parent=$(canonical_path "$canonical_parent") || return 1
    printf '%s/%s\n' "$canonical_parent" "$canonical_name"
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d ' ' -f 1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | cut -d ' ' -f 1
    else
        fail 'sha256sum or shasum is required'
    fi
}

sha256_stdin() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | cut -d ' ' -f 1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | cut -d ' ' -f 1
    else
        fail 'sha256sum or shasum is required'
    fi
}

shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        check|apply|enable|disable|status)
            COMMAND=$1
            shift
            ;;
        --global)
            [ -z "$SCOPE" ] || fail 'select exactly one update scope'
            SCOPE=global
            shift
            ;;
        --project)
            [ "$#" -ge 2 ] || fail '--project requires a directory'
            [ -z "$SCOPE" ] || fail 'select exactly one update scope'
            SCOPE=project
            PROJECT_ROOT=$2
            shift 2
            ;;
        --project=*)
            [ -z "$SCOPE" ] || fail 'select exactly one update scope'
            SCOPE=project
            PROJECT_ROOT=${1#*=}
            [ -n "$PROJECT_ROOT" ] || fail '--project requires a directory'
            shift
            ;;
        --dry-run|-n)
            DRY_RUN=1
            shift
            ;;
        --auto)
            AUTO_INVOCATION=1
            COMMAND=apply
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

[ -n "${HOME:-}" ] || fail 'HOME is required'
case "$HOME" in /*) ;; *) fail 'HOME must be absolute' ;; esac

SCRIPT_PATH=$0
case "$SCRIPT_PATH" in /*) ;; *) SCRIPT_PATH=$PWD/$SCRIPT_PATH ;; esac
SCRIPT_PATH=$(canonical_path "$SCRIPT_PATH") || fail 'cannot resolve updater path'
SCRIPT_SKILL_ROOT=$(canonical_path "$(dirname "$SCRIPT_PATH")/..") ||
    fail 'cannot resolve installed Skill root'

if [ -z "$SCOPE" ]; then
    global_root=$(canonical_path "$HOME/.agents/skills/traceknot") || true
    if [ -n "$global_root" ] && [ "$SCRIPT_SKILL_ROOT" = "$global_root" ]; then
        SCOPE=global
    else
        case "$SCRIPT_SKILL_ROOT" in
            */.agents/skills/traceknot)
                SCOPE=project
                PROJECT_ROOT=${SCRIPT_SKILL_ROOT%/.agents/skills/traceknot}
                [ -n "$PROJECT_ROOT" ] || PROJECT_ROOT=/
                ;;
            *) fail 'cannot infer update scope; pass --global or --project DIR' ;;
        esac
    fi
fi

if [ "$SCOPE" = global ]; then
    REGISTRATION=$HOME/.agents/skills/traceknot
    STATE_HOME=${XDG_STATE_HOME:-"$HOME/.local/state"}
    case "$STATE_HOME" in /*) ;; *) fail 'XDG_STATE_HOME must be absolute' ;; esac
    STATE_DIR=$STATE_HOME/traceknot/skills-update-global
    PROJECT_ROOT=
    LOCK_FILE=${XDG_STATE_HOME:+$XDG_STATE_HOME/skills/.skill-lock.json}
    [ -n "$LOCK_FILE" ] || LOCK_FILE=$HOME/.agents/.skill-lock.json
    UPDATE_ID=global:$REGISTRATION
else
    case "$PROJECT_ROOT" in
        /*) ;;
        *) PROJECT_ROOT=$PWD/$PROJECT_ROOT ;;
    esac
    [ -d "$PROJECT_ROOT" ] || fail "project directory does not exist: $PROJECT_ROOT"
    [ ! -L "$PROJECT_ROOT" ] || fail "refusing symlink project root: $PROJECT_ROOT"
    PROJECT_ROOT=$(canonical_path "$PROJECT_ROOT") || fail 'cannot resolve project root'
    [ "$PROJECT_ROOT" != / ] || fail 'refusing filesystem root as a project'
    REGISTRATION=$PROJECT_ROOT/.agents/skills/traceknot
    STATE_DIR=$PROJECT_ROOT/.agents/.traceknot-update
    LOCK_FILE=$PROJECT_ROOT/skills-lock.json
    UPDATE_ID=project:$PROJECT_ROOT
fi

[ -d "$REGISTRATION" ] || fail "Traceknot is not installed at $REGISTRATION"
[ ! -L "$REGISTRATION" ] || fail "refusing symlink Skill registration: $REGISTRATION"
REGISTRATION=$(canonical_path "$REGISTRATION") || fail 'cannot resolve Skill registration'
[ "$SCRIPT_SKILL_ROOT" = "$REGISTRATION" ] ||
    fail "updater scope does not match its installed Skill: $SCRIPT_SKILL_ROOT"
[ -f "$REGISTRATION/SKILL.md" ] && [ ! -L "$REGISTRATION/SKILL.md" ] ||
    fail 'installed SKILL.md is missing or unsafe'
[ -x "$REGISTRATION/bin/traceknot" ] || fail 'installed Traceknot runtime is missing'
[ -x "$REGISTRATION/bin/traceknot-skills-update" ] || fail 'installed Skills updater is missing'

carriage_return=$(printf '\r')
case "$REGISTRATION$STATE_DIR$PROJECT_ROOT${PATH:-}" in
    *"$carriage_return"*|*'
'*) fail 'update paths and PATH must not contain line breaks' ;;
esac
case "$REGISTRATION$STATE_DIR$PROJECT_ROOT${PATH:-}" in
    *\\%*) fail 'update paths and PATH must not contain backslash-percent sequences' ;;
esac

mkdir -p "$(dirname "$STATE_DIR")"
if [ -e "$STATE_DIR" ] || [ -L "$STATE_DIR" ]; then
    [ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ] ||
        fail "refusing unsafe update state directory: $STATE_DIR"
else
    mkdir "$STATE_DIR"
fi

CONFIG=$STATE_DIR/config
OBSERVATIONS=$STATE_DIR/observations.tsv
ACTIVE_STATE=$STATE_DIR/active.json
LOCK_DIR=$STATE_DIR/update.lock
RECOVERY_LOCK=$STATE_DIR/update.lock-recovery

cleanup() {
    if [ -n "$LOCK_CLAIM" ] && [ -f "$LOCK_CLAIM" ] &&
       [ ! -L "$LOCK_CLAIM" ] &&
       [ "$(sed -n '1p' "$LOCK_CLAIM" 2>/dev/null || true)" = "$$" ]; then
        rm -f "$LOCK_CLAIM"
    fi
    LOCK_CLAIM=
    if [ "$LOCK_HELD" -eq 1 ]; then
        rm -f "$LOCK_DIR"
    fi
    if [ "$RECOVERY_LOCK_HELD" -ne 0 ]; then
        rm -f "$RECOVERY_LOCK"
    fi
    if [ -n "$TMP_ROOT" ]; then
        rm -rf "$TMP_ROOT"
    fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

create_exclusive_file() {
    exclusive_path=$1
    if [ -e "$exclusive_path" ] || [ -L "$exclusive_path" ]; then
        fail "refusing existing state temporary path: $exclusive_path"
    fi
    (set -C; : > "$exclusive_path") 2>/dev/null ||
        fail "cannot create state temporary file: $exclusive_path"
    [ -f "$exclusive_path" ] && [ ! -L "$exclusive_path" ] ||
        fail "unsafe state temporary path: $exclusive_path"
}

try_acquire_lock() {
    LOCK_CLAIM=$STATE_DIR/.update-lock-claim.$$
    if ! (set -C; printf '%s\n' "$$" > "$LOCK_CLAIM") 2>/dev/null; then
        fail "unsafe update lock claim path: $LOCK_CLAIM"
    fi
    [ -f "$LOCK_CLAIM" ] && [ ! -L "$LOCK_CLAIM" ] ||
        fail "unsafe update lock claim path: $LOCK_CLAIM"
    lock_claim=$LOCK_CLAIM
    if [ ! -e "$LOCK_DIR" ] && [ ! -L "$LOCK_DIR" ] &&
       ln "$lock_claim" "$LOCK_DIR" 2>/dev/null; then
        if [ ! -f "$LOCK_DIR" ] || [ -L "$LOCK_DIR" ]; then
            rm -f "$lock_claim"
            LOCK_CLAIM=
            return 1
        fi
        rm -f "$lock_claim"
        LOCK_CLAIM=
        LOCK_HELD=1
        return 0
    fi
    rm -f "$lock_claim"
    LOCK_CLAIM=
    return 1
}

acquire_recovery_guard() {
    if [ -e "$RECOVERY_LOCK" ] || [ -L "$RECOVERY_LOCK" ]; then
        [ -f "$RECOVERY_LOCK" ] && [ ! -L "$RECOVERY_LOCK" ] ||
            fail "unsafe stale-lock recovery path: $RECOVERY_LOCK"
    fi
    if command -v shlock >/dev/null 2>&1; then
        shlock -f "$RECOVERY_LOCK" -p "$$" ||
            fail "stale-lock recovery is already in progress: $RECOVERY_LOCK"
        RECOVERY_LOCK_HELD=1
    elif command -v flock >/dev/null 2>&1; then
        if [ ! -e "$RECOVERY_LOCK" ]; then
            (set -C; : > "$RECOVERY_LOCK") 2>/dev/null ||
                fail "cannot create stale-lock recovery guard: $RECOVERY_LOCK"
        fi
        [ -f "$RECOVERY_LOCK" ] && [ ! -L "$RECOVERY_LOCK" ] ||
            fail "unsafe stale-lock recovery path: $RECOVERY_LOCK"
        exec 9>>"$RECOVERY_LOCK"
        flock -n 9 || fail "stale-lock recovery is already in progress: $RECOVERY_LOCK"
        RECOVERY_LOCK_HELD=2
    else
        fail 'shlock or flock is required for safe stale-lock recovery'
    fi
}

acquire_lock() {
    try_acquire_lock && return
    [ -f "$LOCK_DIR" ] && [ ! -L "$LOCK_DIR" ] ||
        fail "unsafe update lock path: $LOCK_DIR"
    lock_pid=$(sed -n '1p' "$LOCK_DIR" 2>/dev/null || true)
    case "$lock_pid" in
        ''|*[!0-9]*) fail "update lock has invalid ownership metadata: $LOCK_DIR" ;;
    esac
    if kill -0 "$lock_pid" 2>/dev/null; then
        fail "another update owns the lock: $LOCK_DIR"
    fi
    acquire_recovery_guard
    if [ -e "$LOCK_DIR" ]; then
        [ -f "$LOCK_DIR" ] && [ ! -L "$LOCK_DIR" ] ||
            fail "unsafe update lock path during recovery: $LOCK_DIR"
        recovered_pid=$(sed -n '1p' "$LOCK_DIR" 2>/dev/null || true)
        [ "$recovered_pid" = "$lock_pid" ] ||
            fail 'update lock changed during stale-lock recovery'
        kill -0 "$recovered_pid" 2>/dev/null &&
            fail 'update lock owner became live during recovery'
        rm -f "$LOCK_DIR"
    fi
    try_acquire_lock || fail 'cannot acquire update lock after stale-lock recovery'
    rm -f "$RECOVERY_LOCK"
    RECOVERY_LOCK_HELD=0
}

acquire_lock

if [ ! -f "$CONFIG" ]; then
    config_tmp=$CONFIG.tmp.$$
    create_exclusive_file "$config_tmp"
    printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
        'traceknot-skills-update-config/v1' \
        'automatic=0' \
        'lastCheck=0' \
        "scope=$SCOPE" \
        "projectRoot=$PROJECT_ROOT" \
        'adoptedAt=0' \
        'adoptedLockSha256=' > "$config_tmp"
    mv "$config_tmp" "$CONFIG"
fi
[ -f "$CONFIG" ] && [ ! -L "$CONFIG" ] || fail 'unsafe update configuration'
[ "$(sed -n '1p' "$CONFIG")" = traceknot-skills-update-config/v1 ] ||
    fail 'unsupported update configuration'
[ "$(wc -l < "$CONFIG" | tr -d ' ')" -eq 7 ] || fail 'invalid update configuration length'
for config_key in automatic lastCheck scope projectRoot adoptedAt adoptedLockSha256; do
    [ "$(grep -c "^$config_key=" "$CONFIG")" -eq 1 ] ||
        fail "invalid update configuration field: $config_key"
done
AUTOMATIC=$(sed -n 's/^automatic=//p' "$CONFIG")
LAST_CHECK=$(sed -n 's/^lastCheck=//p' "$CONFIG")
CONFIG_SCOPE=$(sed -n 's/^scope=//p' "$CONFIG")
CONFIG_PROJECT_ROOT=$(sed -n 's/^projectRoot=//p' "$CONFIG")
ADOPTED_AT=$(sed -n 's/^adoptedAt=//p' "$CONFIG")
ADOPTED_LOCK_SHA256=$(sed -n 's/^adoptedLockSha256=//p' "$CONFIG")
case "$AUTOMATIC" in 0|1) ;; *) fail 'invalid automatic update setting' ;; esac
case "$LAST_CHECK" in ''|*[!0-9]*) fail 'invalid last check time' ;; esac
case "$ADOPTED_AT" in ''|*[!0-9]*) fail 'invalid adoption time' ;; esac
case "$ADOPTED_LOCK_SHA256" in '') ;; *[!0-9a-f]*) fail 'invalid adopted lock digest' ;; esac
if [ "$ADOPTED_AT" -eq 0 ]; then
    [ -z "$ADOPTED_LOCK_SHA256" ] || fail 'uninitialized adoption state has a lock digest'
else
    [ "${#ADOPTED_LOCK_SHA256}" -eq 64 ] || fail 'adopted lock digest must be SHA-256'
fi
[ "$CONFIG_SCOPE" = "$SCOPE" ] || fail 'update state belongs to another scope'
[ "$CONFIG_PROJECT_ROOT" = "$PROJECT_ROOT" ] || fail 'update state belongs to another project'

write_config() {
    automatic_value=$1
    last_check_value=$2
    adopted_at_value=$3
    adopted_lock_value=$4
    config_tmp=$CONFIG.tmp.$$
    create_exclusive_file "$config_tmp"
    printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
        'traceknot-skills-update-config/v1' \
        "automatic=$automatic_value" \
        "lastCheck=$last_check_value" \
        "scope=$SCOPE" \
        "projectRoot=$PROJECT_ROOT" \
        "adoptedAt=$adopted_at_value" \
        "adoptedLockSha256=$adopted_lock_value" > "$config_tmp"
    mv "$config_tmp" "$CONFIG"
}

cron_escape() {
    printf '%s' "$1" | sed 's/%/\\%/g'
}

read_existing_crontab() {
    crontab_error=$(mktemp "${TMPDIR:-/tmp}/traceknot-crontab.XXXXXX") ||
        fail 'cannot create crontab diagnostic file'
    if existing=$(crontab -l 2>"$crontab_error"); then
        rm -f "$crontab_error"
        return
    fi
    if grep -Eiq 'no crontab (for|exists)' "$crontab_error"; then
        existing=
        rm -f "$crontab_error"
        return
    fi
    cat "$crontab_error" >&2
    rm -f "$crontab_error"
    fail 'cannot read existing crontab safely'
}

cron_marker=$(cron_escape "# traceknot-skills-auto-update:$UPDATE_ID")
remove_schedule() {
    command -v crontab >/dev/null 2>&1 || return 0
    read_existing_crontab
    filtered=$(printf '%s\n' "$existing" |
        TRACEKNOT_CRON_MARKER=$cron_marker awk '
          BEGIN { marker=ENVIRON["TRACEKNOT_CRON_MARKER"] }
          substr($0, length($0) - length(marker) + 1) != marker
        ')
    if [ -n "$filtered" ]; then
        printf '%s\n' "$filtered" | crontab -
    elif [ -n "$existing" ]; then
        printf '%s' '' | crontab -
    fi
}

install_schedule() {
    command -v crontab >/dev/null 2>&1 || fail 'crontab is required to enable automatic updates'
    updater=$REGISTRATION/bin/traceknot-skills-update
    [ -x "$updater" ] || fail "installed updater is missing: $updater"
    read_existing_crontab
    filtered=$(printf '%s\n' "$existing" |
        TRACEKNOT_CRON_MARKER=$cron_marker awk '
          BEGIN { marker=ENVIRON["TRACEKNOT_CRON_MARKER"] }
          substr($0, length($0) - length(marker) + 1) != marker
        ')
    if [ "$SCOPE" = global ]; then
        raw_command="HOME=$(shell_quote "$HOME") PATH=$(shell_quote "${PATH:-/usr/bin:/bin}")"
        if [ -n "${XDG_STATE_HOME:-}" ]; then
            raw_command="$raw_command XDG_STATE_HOME=$(shell_quote "$XDG_STATE_HOME")"
        fi
        raw_command="$raw_command $(shell_quote "$updater") --global --auto"
    else
        raw_command="cd $(shell_quote "$PROJECT_ROOT") && HOME=$(shell_quote "$HOME") PATH=$(shell_quote "${PATH:-/usr/bin:/bin}") $(shell_quote "$updater") --project $(shell_quote "$PROJECT_ROOT") --auto"
    fi
    raw_entry="23 3 * * * $raw_command >/dev/null 2>&1 # traceknot-skills-auto-update:$UPDATE_ID"
    entry=$(cron_escape "$raw_entry")
    {
        [ -z "$filtered" ] || printf '%s\n' "$filtered"
        printf '%s\n' "$entry"
    } | crontab -
}

validate_active_state() {
    [ -e "$ACTIVE_STATE" ] || return 0
    [ -f "$ACTIVE_STATE" ] && [ ! -L "$ACTIVE_STATE" ] || fail 'unsafe active release state'
    jq -e --arg scope "$SCOPE" --arg registration "$REGISTRATION" '
      type == "object"
      and (keys | sort == ["appliedAt","artifactSha256","lockEntrySha256","registration","releaseTag","schemaVersion","scope","sourceCommit","version"])
      and .schemaVersion == "traceknot-skills-active-release/v1"
      and .scope == $scope
      and .registration == $registration
      and (.version | test("^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"))
      and .releaseTag == ("v" + .version)
      and (.sourceCommit | test("^[0-9a-f]{40}$"))
      and (.artifactSha256 | test("^[0-9a-f]{64}$"))
      and (.lockEntrySha256 | test("^[0-9a-f]{64}$"))
      and (.appliedAt | type == "number" and floor == . and . >= 0)
    ' "$ACTIVE_STATE" >/dev/null || fail 'invalid active release state'
}

validate_skills_lock() {
    [ -f "$LOCK_FILE" ] && [ ! -L "$LOCK_FILE" ] ||
        fail "Skills CLI lock file is missing or unsafe: $LOCK_FILE"
    jq -e '
      .skills.traceknot.source == "Jin-Doh/traceknot"
      and .skills.traceknot.sourceType == "github"
      and .skills.traceknot.skillPath == "skill/SKILL.md"
    ' "$LOCK_FILE" >/dev/null ||
        fail 'installed Traceknot registration is not owned by the expected Skills CLI source'
    LOCK_REF=$(jq -r '.skills.traceknot.ref // empty' "$LOCK_FILE")
    LOCK_ENTRY_SHA256=$(jq -cS '.skills.traceknot' "$LOCK_FILE" | sha256_stdin)
    [ "${#LOCK_ENTRY_SHA256}" -eq 64 ] || fail 'cannot hash the Skills CLI lock entry'
    if [ -f "$ACTIVE_STATE" ]; then
        ACTIVE_SOURCE_COMMIT=$(jq -r .sourceCommit "$ACTIVE_STATE")
        ACTIVE_LOCK_ENTRY_SHA256=$(jq -r .lockEntrySha256 "$ACTIVE_STATE")
        [ "$LOCK_REF" = "$ACTIVE_SOURCE_COMMIT" ] ||
            fail 'Skills CLI lock changed outside the managed update state; refusing to overwrite it'
        [ "$LOCK_ENTRY_SHA256" = "$ACTIVE_LOCK_ENTRY_SHA256" ] ||
            fail 'Skills CLI lock metadata changed outside the managed update state; refusing to overwrite it'
    elif [ "$ADOPTED_AT" -ne 0 ]; then
        [ "$LOCK_ENTRY_SHA256" = "$ADOPTED_LOCK_SHA256" ] ||
            fail 'unmanaged Skills CLI lock changed after adoption; refusing to select an automatic baseline'
    fi
}

if [ "$COMMAND" != disable ]; then
    command -v jq >/dev/null 2>&1 || fail 'jq is required'
    command -v sha256sum >/dev/null 2>&1 ||
        command -v shasum >/dev/null 2>&1 ||
        fail 'sha256sum or shasum is required'
    validate_active_state
    validate_skills_lock
fi

if [ "$COMMAND" = enable ]; then
    [ "$DRY_RUN" -eq 0 ] || { printf 'Would enable daily automatic updates for %s\n' "$REGISTRATION"; exit 0; }
    for dependency in crontab curl jq gh tar diff npx sync; do
        command -v "$dependency" >/dev/null 2>&1 ||
            fail "$dependency is required to enable automatic updates"
    done
    command -v sha256sum >/dev/null 2>&1 ||
        command -v shasum >/dev/null 2>&1 ||
        fail 'sha256sum or shasum is required to enable automatic updates'
    install_schedule
    write_config 1 "$LAST_CHECK" "$ADOPTED_AT" "$ADOPTED_LOCK_SHA256"
    printf 'Automatic Skills updates enabled for %s\n' "$REGISTRATION"
    exit 0
fi

if [ "$COMMAND" = disable ]; then
    [ "$DRY_RUN" -eq 0 ] || { printf 'Would disable automatic updates for %s\n' "$REGISTRATION"; exit 0; }
    if [ "$AUTOMATIC" -eq 1 ]; then
        command -v crontab >/dev/null 2>&1 ||
            fail 'crontab is required to disable automatic updates safely'
    fi
    remove_schedule
    write_config 0 "$LAST_CHECK" "$ADOPTED_AT" "$ADOPTED_LOCK_SHA256"
    printf 'Automatic Skills updates disabled for %s\n' "$REGISTRATION"
    exit 0
fi

if [ "$COMMAND" = status ]; then
    printf 'scope=%s\nprojectRoot=%s\nregistration=%s\nautomatic=%s\nlastCheck=%s\nadoptedAt=%s\n' \
        "$SCOPE" "$PROJECT_ROOT" "$REGISTRATION" "$AUTOMATIC" "$LAST_CHECK" "$ADOPTED_AT"
    if [ -f "$ACTIVE_STATE" ]; then
        jq -r '"version=\(.version)\ntag=\(.releaseTag)\nsourceCommit=\(.sourceCommit)\nsha256=\(.artifactSha256)"' "$ACTIVE_STATE"
    else
        printf '%s\n' 'version=unmanaged'
    fi
    exit 0
fi

if [ "$AUTO_INVOCATION" -eq 1 ] && [ "$AUTOMATIC" -ne 1 ]; then
    exit 0
fi

command -v curl >/dev/null 2>&1 || fail 'curl is required'
command -v jq >/dev/null 2>&1 || fail 'jq is required'
command -v sha256sum >/dev/null 2>&1 ||
    command -v shasum >/dev/null 2>&1 ||
    fail 'sha256sum or shasum is required'

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/traceknot-skills-update.XXXXXX") ||
    fail 'cannot create temporary directory'
HEADERS=$TMP_ROOT/headers
RELEASE_JSON=$TMP_ROOT/releases.json

validate_asset_api_url() {
    case "$1" in
        "$API_URL"/assets/*) ;;
        *) fail "release asset URL is outside the approved GitHub API origin: $1" ;;
    esac
}

curl_authorization=
if [ -n "${GH_TOKEN:-}" ]; then
    curl_authorization="Authorization: Bearer $GH_TOKEN"
fi

fetch_release_page() {
    fetch_url=$1
    fetch_headers=$2
    fetch_output=$3
    if [ -n "$curl_authorization" ]; then
        curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --silent --show-error --location \
            -H 'Accept: application/vnd.github+json' -H "$curl_authorization" \
            -D "$fetch_headers" -o "$fetch_output" "$fetch_url"
    else
        curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --silent --show-error --location \
            -H 'Accept: application/vnd.github+json' \
            -D "$fetch_headers" -o "$fetch_output" "$fetch_url"
    fi
}

fetch_asset() {
    asset_url=$1
    asset_output=$2
    validate_asset_api_url "$asset_url"
    if [ -n "$curl_authorization" ]; then
        curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --silent --show-error --location \
            -H 'Accept: application/octet-stream' -H "$curl_authorization" \
            -o "$asset_output" "$asset_url"
    else
        curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --silent --show-error --location \
            -H 'Accept: application/octet-stream' -o "$asset_output" "$asset_url"
    fi
}

printf '%s\n' '[]' > "$RELEASE_JSON"
release_page=1
while :; do
    page_json=$TMP_ROOT/releases-$release_page.json
    page_headers=$TMP_ROOT/headers-$release_page
    fetch_release_page "$API_URL?per_page=100&page=$release_page" "$page_headers" "$page_json"
    jq -e 'type == "array"' "$page_json" >/dev/null || fail 'invalid GitHub releases response'
    [ "$release_page" -ne 1 ] || cp "$page_headers" "$HEADERS"
    page_count=$(jq 'length' "$page_json")
    combined_json=$TMP_ROOT/releases-combined.json
    jq -s '.[0] + .[1]' "$RELEASE_JSON" "$page_json" > "$combined_json"
    mv "$combined_json" "$RELEASE_JSON"
    [ "$page_count" -eq 100 ] || break
    release_page=$((release_page + 1))
    [ "$release_page" -le 100 ] || fail 'GitHub releases pagination exceeded safety limit'
done

SERVER_DATE=$(sed -n 's/^[Dd]ate: //p' "$HEADERS" | tr -d '\r' | tail -n 1)
[ -n "$SERVER_DATE" ] || fail 'GitHub response did not include trusted server time'
TRUSTED_NOW=$(jq -nr --arg value "$SERVER_DATE" '$value | strptime("%a, %d %b %Y %H:%M:%S GMT") | mktime') ||
    fail 'cannot parse trusted GitHub server time'
LOCAL_NOW=$(date -u '+%s')
CLOCK_DELTA=$((LOCAL_NOW - TRUSTED_NOW))
[ "$CLOCK_DELTA" -le 86400 ] && [ "$CLOCK_DELTA" -ge -86400 ] ||
    fail 'local clock differs from GitHub server time by more than 24 hours'

if [ "$AUTO_INVOCATION" -eq 1 ] && [ $((TRUSTED_NOW - LAST_CHECK)) -lt "$CHECK_INTERVAL" ]; then
    exit 0
fi
ADOPTION_CREATED=0
if [ ! -f "$ACTIVE_STATE" ] && [ "$ADOPTED_AT" -eq 0 ]; then
    ADOPTED_AT=$TRUSTED_NOW
    ADOPTED_LOCK_SHA256=$LOCK_ENTRY_SHA256
    ADOPTION_CREATED=1
fi
write_config "$AUTOMATIC" "$TRUSTED_NOW" "$ADOPTED_AT" "$ADOPTED_LOCK_SHA256"

jq -r '
  .[]
  | select(.draft == false and .prerelease == false and .immutable == true)
  | . as $release
  | [.assets[]? | select(.name == "traceknot-update-manifest.json")][0] as $manifest
  | select($manifest != null)
  | [$release.tag_name, $release.published_at, $manifest.url]
  | @tsv
' "$RELEASE_JSON" > "$TMP_ROOT/candidates.tsv"

CANDIDATE_FOUND=0
POST_ADOPTION_CANDIDATE=0
ELIGIBLE=0
CURRENT_MATCH=0
SELECTED_VERSION=
while IFS="$(printf '\t')" read -r RELEASE_TAG RELEASE_PUBLISHED MANIFEST_URL; do
    [ -n "$RELEASE_TAG" ] || continue
    CANDIDATE_FOUND=1
    RELEASE_EPOCH=$(jq -nr --arg value "$RELEASE_PUBLISHED" '$value | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601') ||
        fail 'release publication time is invalid'
    if [ ! -f "$ACTIVE_STATE" ] && [ "$RELEASE_EPOCH" -le "$ADOPTED_AT" ]; then
        continue
    fi
    POST_ADOPTION_CANDIDATE=1
    MANIFEST=$TMP_ROOT/manifest.json
    fetch_asset "$MANIFEST_URL" "$MANIFEST"
    jq -e '
      type == "object"
      and (keys | sort == ["artifact","publishedAt","releaseTag","schemaVersion","sourceCommit","sourceRepository","version"])
      and .schemaVersion == "traceknot-update-manifest/v1"
      and .sourceRepository == "Jin-Doh/traceknot"
      and (.version | test("^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"))
      and .releaseTag == ("v" + .version)
      and (.sourceCommit | test("^[0-9a-f]{40}$"))
      and (.publishedAt | test("^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"))
      and (.artifact | type == "object")
      and (.artifact | keys | sort == ["name","sha256","size"])
      and .artifact.name == ("traceknot-v" + .version + ".tar.gz")
      and (.artifact.size | type == "number" and . > 0 and floor == .)
      and (.artifact.sha256 | test("^[0-9a-f]{64}$"))
    ' "$MANIFEST" >/dev/null || fail "invalid update manifest for $RELEASE_TAG"

    [ "$(jq -r .releaseTag "$MANIFEST")" = "$RELEASE_TAG" ] ||
        fail 'release tag and manifest tag disagree'
    MANIFEST_PUBLISHED=$(jq -r .publishedAt "$MANIFEST")
    MANIFEST_EPOCH=$(jq -nr --arg value "$MANIFEST_PUBLISHED" '$value | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601') ||
        fail 'manifest publication time is not a valid calendar instant'
    [ "$MANIFEST_EPOCH" -le "$TRUSTED_NOW" ] || fail 'manifest publication time is in the future'

    MANIFEST_SHA=$(sha256_file "$MANIFEST")
    if [ -e "$OBSERVATIONS" ] || [ -L "$OBSERVATIONS" ]; then
        [ -f "$OBSERVATIONS" ] && [ ! -L "$OBSERVATIONS" ] || fail 'refusing unsafe observations file'
    else
        create_exclusive_file "$OBSERVATIONS"
    fi
    FIRST_SEEN=$(grep "^$MANIFEST_SHA$(printf '\t')" "$OBSERVATIONS" 2>/dev/null | cut -f 2 | tail -n 1 || true)
    if [ -z "$FIRST_SEEN" ]; then
        FIRST_SEEN=$TRUSTED_NOW
        printf '%s\t%s\t%s\t%s\n' "$MANIFEST_SHA" "$FIRST_SEEN" "$RELEASE_TAG" "$(jq -r .artifact.sha256 "$MANIFEST")" >> "$OBSERVATIONS"
    fi
    case "$FIRST_SEEN" in ''|*[!0-9]*) fail 'invalid candidate observation time' ;; esac
    AGE_BASE=$RELEASE_EPOCH
    [ "$FIRST_SEEN" -le "$AGE_BASE" ] || AGE_BASE=$FIRST_SEEN
    if [ "$TRUSTED_NOW" -le $((AGE_BASE + MIN_AGE)) ]; then
        printf 'Observing %s; eligible after %s trusted epoch seconds\n' "$RELEASE_TAG" "$((AGE_BASE + MIN_AGE))"
        continue
    fi

    VERSION=$(jq -r .version "$MANIFEST")
    SOURCE_COMMIT=$(jq -r .sourceCommit "$MANIFEST")
    ARTIFACT_NAME=$(jq -r .artifact.name "$MANIFEST")
    ARTIFACT_SIZE=$(jq -r .artifact.size "$MANIFEST")
    ARTIFACT_SHA=$(jq -r .artifact.sha256 "$MANIFEST")
    if [ -f "$ACTIVE_STATE" ]; then
        ACTIVE_VERSION=$(jq -r .version "$ACTIVE_STATE")
        ACTIVE_SHA=$(jq -r .artifactSha256 "$ACTIVE_STATE")
        VERSION_ORDER=$(jq -nr --arg candidate "$VERSION" --arg active "$ACTIVE_VERSION" '
          ($candidate | split(".") | map(tonumber)) as $c
          | ($active | split(".") | map(tonumber)) as $a
          | if $c < $a then -1 elif $c == $a then 0 else 1 end
        ')
        if [ "$VERSION_ORDER" -lt 0 ]; then
            continue
        fi
        if [ "$VERSION_ORDER" -eq 0 ]; then
            [ "$ARTIFACT_SHA" = "$ACTIVE_SHA" ] ||
                fail "installed version $VERSION was republished with a different digest"
            CURRENT_MATCH=1
            continue
        fi
    elif [ -f "$LOCK_FILE" ] && [ ! -L "$LOCK_FILE" ]; then
        LOCK_REF=$(jq -r '.skills.traceknot.ref // empty' "$LOCK_FILE" 2>/dev/null || true)
        if [ "$LOCK_REF" = "$SOURCE_COMMIT" ]; then
            CURRENT_MATCH=1
            continue
        fi
    fi

    ARTIFACT_URL=$(jq -r --arg name "$ARTIFACT_NAME" --arg tag "$RELEASE_TAG" '
      .[] | select(.tag_name == $tag) | [.assets[] | select(.name == $name) | .url][0] // empty
    ' "$RELEASE_JSON")
    [ -n "$ARTIFACT_URL" ] || fail "release asset is missing: $ARTIFACT_NAME"
    validate_asset_api_url "$ARTIFACT_URL"
    if [ "$ELIGIBLE" -eq 1 ]; then
        SELECTION_ORDER=$(jq -nr --arg candidate "$VERSION" --arg selected "$SELECTED_VERSION" '
          ($candidate | split(".") | map(tonumber)) as $c
          | ($selected | split(".") | map(tonumber)) as $s
          | if $c < $s then -1 elif $c == $s then 0 else 1 end
        ')
        if [ "$SELECTION_ORDER" -lt 0 ]; then
            continue
        fi
        if [ "$SELECTION_ORDER" -eq 0 ]; then
            [ "$ARTIFACT_SHA" = "$SELECTED_ARTIFACT_SHA" ] ||
                fail "eligible version $VERSION has conflicting artifact digests"
            continue
        fi
    fi
    ELIGIBLE=1
    SELECTED_RELEASE_TAG=$RELEASE_TAG
    SELECTED_VERSION=$VERSION
    SELECTED_SOURCE_COMMIT=$SOURCE_COMMIT
    SELECTED_ARTIFACT_NAME=$ARTIFACT_NAME
    SELECTED_ARTIFACT_SIZE=$ARTIFACT_SIZE
    SELECTED_ARTIFACT_SHA=$ARTIFACT_SHA
    SELECTED_ARTIFACT_URL=$ARTIFACT_URL
    cp "$MANIFEST" "$TMP_ROOT/eligible-manifest.json"
done < "$TMP_ROOT/candidates.tsv"

if [ "$CANDIDATE_FOUND" -eq 0 ]; then
    printf '%s\n' 'No immutable stable release with an update manifest is available.'
    exit 0
fi
if [ "$POST_ADOPTION_CANDIDATE" -eq 0 ] && [ ! -f "$ACTIVE_STATE" ]; then
    if [ "$ADOPTION_CREATED" -eq 1 ]; then
        printf 'Recorded unmanaged installation baseline at %s; pre-existing releases will not be applied automatically.\n' "$ADOPTED_AT"
    else
        printf 'No release published after the unmanaged installation baseline at %s is available.\n' "$ADOPTED_AT"
    fi
    exit 0
fi
if [ "$ELIGIBLE" -eq 0 ] && [ "$CURRENT_MATCH" -eq 1 ]; then
    printf '%s\n' 'The newest eligible Traceknot release is already installed.'
    exit 0
fi
if [ "$ELIGIBLE" -eq 0 ]; then
    printf '%s\n' 'No release has exceeded the seven-day observation requirement.'
    exit 0
fi

RELEASE_TAG=$SELECTED_RELEASE_TAG
VERSION=$SELECTED_VERSION
SOURCE_COMMIT=$SELECTED_SOURCE_COMMIT
ARTIFACT_NAME=$SELECTED_ARTIFACT_NAME
ARTIFACT_SIZE=$SELECTED_ARTIFACT_SIZE
ARTIFACT_SHA=$SELECTED_ARTIFACT_SHA
ARTIFACT_URL=$SELECTED_ARTIFACT_URL
printf 'Eligible update: %s (%s)\n' "$RELEASE_TAG" "$ARTIFACT_SHA"
[ "$COMMAND" = apply ] || exit 0
[ "$DRY_RUN" -eq 0 ] || { printf 'Would apply %s through Skills CLI to %s\n' "$RELEASE_TAG" "$REGISTRATION"; exit 0; }

for dependency in gh tar diff npx sync; do
    command -v "$dependency" >/dev/null 2>&1 || fail "$dependency is required to apply an update"
done

ARCHIVE=$TMP_ROOT/$ARTIFACT_NAME
fetch_asset "$ARTIFACT_URL" "$ARCHIVE"
[ "$(wc -c < "$ARCHIVE" | tr -d ' ')" = "$ARTIFACT_SIZE" ] ||
    fail 'artifact size does not match manifest'
[ "$(sha256_file "$ARCHIVE")" = "$ARTIFACT_SHA" ] ||
    fail 'artifact digest does not match manifest'

gh attestation verify "$ARCHIVE" \
    --repo "$REPOSITORY" \
    --signer-workflow "$SIGNER_WORKFLOW" \
    --source-ref "refs/tags/$RELEASE_TAG" \
    --source-digest "$SOURCE_COMMIT" \
    --deny-self-hosted-runners >/dev/null || fail 'artifact provenance verification failed'

VERIFIED_RELEASE=$TMP_ROOT/verified-release
mkdir "$VERIFIED_RELEASE"
tar -tzf "$ARCHIVE" | while IFS= read -r entry; do
    case "$entry" in
        /*|../*|*/../*|*/..|..) fail "unsafe archive entry: $entry" ;;
    esac
done
tar -xzf "$ARCHIVE" -C "$VERIFIED_RELEASE" --strip-components 1
if find "$VERIFIED_RELEASE" -type l -print | grep . >/dev/null; then
    fail 'release archive contains a symbolic link'
fi
if find "$VERIFIED_RELEASE" ! -type f ! -type d -print | grep . >/dev/null; then
    fail 'release archive contains a special filesystem entry'
fi
[ -f "$VERIFIED_RELEASE/skill/SKILL.md" ] || fail 'verified release is missing SKILL.md'
[ -x "$VERIFIED_RELEASE/skill/bin/traceknot" ] || fail 'verified release is missing the Traceknot runtime'
[ -x "$VERIFIED_RELEASE/skill/bin/traceknot-skills-update" ] || fail 'verified release is missing the Skills updater'

SOURCE_INPUT=$REPOSITORY#$SOURCE_COMMIT
PREFLIGHT_ROOT=$TMP_ROOT/preflight
mkdir "$PREFLIGHT_ROOT"
PREFLIGHT_LOG=$TMP_ROOT/preflight.log
if [ "$SCOPE" = global ]; then
    PREFLIGHT_HOME=$PREFLIGHT_ROOT/home
    PREFLIGHT_STATE=$PREFLIGHT_ROOT/state
    mkdir -p "$PREFLIGHT_HOME" "$PREFLIGHT_STATE"
    if ! HOME=$PREFLIGHT_HOME XDG_STATE_HOME=$PREFLIGHT_STATE \
        npx --yes "skills@$SKILLS_CLI_VERSION" add "$SOURCE_INPUT" \
            --skill traceknot --agent universal --global --yes >"$PREFLIGHT_LOG" 2>&1; then
        cat "$PREFLIGHT_LOG" >&2
        fail 'Skills CLI preflight installation failed'
    fi
    PREFLIGHT_SKILL=$PREFLIGHT_HOME/.agents/skills/traceknot
else
    PREFLIGHT_HOME=$PREFLIGHT_ROOT/home
    PREFLIGHT_STATE=$PREFLIGHT_ROOT/state
    PREFLIGHT_PROJECT=$PREFLIGHT_ROOT/project
    mkdir -p "$PREFLIGHT_HOME" "$PREFLIGHT_STATE" "$PREFLIGHT_PROJECT"
    if ! (
        cd "$PREFLIGHT_PROJECT"
        HOME=$PREFLIGHT_HOME XDG_STATE_HOME=$PREFLIGHT_STATE \
            npx --yes "skills@$SKILLS_CLI_VERSION" add "$SOURCE_INPUT" \
                --skill traceknot --agent universal --yes
    ) >"$PREFLIGHT_LOG" 2>&1; then
        cat "$PREFLIGHT_LOG" >&2
        fail 'Skills CLI preflight installation failed'
    fi
    PREFLIGHT_SKILL=$PREFLIGHT_PROJECT/.agents/skills/traceknot
fi
[ -x "$PREFLIGHT_SKILL/bin/traceknot" ] || fail 'preflight Skill runtime is missing'
[ -x "$PREFLIGHT_SKILL/bin/traceknot-skills-update" ] || fail 'preflight Skills updater is missing'
if ! "$PREFLIGHT_SKILL/bin/traceknot" self-check >/dev/null 2>&1; then
    fail 'preflight runtime self-check failed'
fi
if ! diff -r "$VERIFIED_RELEASE/skill" "$PREFLIGHT_SKILL" >/dev/null 2>&1; then
    fail 'Skills CLI preflight payload differs from the verified release artifact'
fi

APPLY_LOG=$TMP_ROOT/apply.log
if [ "$SCOPE" = global ]; then
    if ! npx --yes "skills@$SKILLS_CLI_VERSION" add "$SOURCE_INPUT" \
        --skill traceknot --agent universal --global --yes >"$APPLY_LOG" 2>&1; then
        cat "$APPLY_LOG" >&2
        fail 'Skills CLI update failed'
    fi
else
    if ! (
        cd "$PROJECT_ROOT"
        HOME=$HOME npx --yes "skills@$SKILLS_CLI_VERSION" add "$SOURCE_INPUT" \
            --skill traceknot --agent universal --yes
    ) >"$APPLY_LOG" 2>&1; then
        cat "$APPLY_LOG" >&2
        fail 'Skills CLI update failed'
    fi
fi

[ -d "$REGISTRATION" ] && [ ! -L "$REGISTRATION" ] || fail 'Skills CLI removed the canonical registration'
[ -x "$REGISTRATION/bin/traceknot" ] || fail 'updated Traceknot runtime is missing'
[ -x "$REGISTRATION/bin/traceknot-skills-update" ] || fail 'updated Skills updater is missing'
if ! "$REGISTRATION/bin/traceknot" self-check >/dev/null 2>&1; then
    fail 'updated runtime self-check failed'
fi
if ! diff -r "$VERIFIED_RELEASE/skill" "$REGISTRATION" >/dev/null 2>&1; then
    fail 'installed Skills payload differs from the verified release artifact'
fi
[ -f "$LOCK_FILE" ] && [ ! -L "$LOCK_FILE" ] || fail 'Skills CLI lock file is missing or unsafe'
jq -e --arg commit "$SOURCE_COMMIT" '
  .skills.traceknot.source == "Jin-Doh/traceknot"
  and .skills.traceknot.sourceType == "github"
  and .skills.traceknot.ref == $commit
  and .skills.traceknot.skillPath == "skill/SKILL.md"
' "$LOCK_FILE" >/dev/null || fail 'Skills CLI lock does not bind the verified source commit'
INSTALLED_LOCK_ENTRY_SHA256=$(jq -cS '.skills.traceknot' "$LOCK_FILE" | sha256_stdin)
[ "${#INSTALLED_LOCK_ENTRY_SHA256}" -eq 64 ] || fail 'cannot hash the installed Skills CLI lock entry'

active_tmp=$ACTIVE_STATE.tmp.$$
create_exclusive_file "$active_tmp"
jq -n \
    --arg schemaVersion traceknot-skills-active-release/v1 \
    --arg version "$VERSION" \
    --arg releaseTag "$RELEASE_TAG" \
    --arg sourceCommit "$SOURCE_COMMIT" \
    --arg artifactSha256 "$ARTIFACT_SHA" \
    --arg lockEntrySha256 "$INSTALLED_LOCK_ENTRY_SHA256" \
    --arg scope "$SCOPE" \
    --arg registration "$REGISTRATION" \
    --argjson appliedAt "$TRUSTED_NOW" \
    '{schemaVersion:$schemaVersion,version:$version,releaseTag:$releaseTag,sourceCommit:$sourceCommit,artifactSha256:$artifactSha256,lockEntrySha256:$lockEntrySha256,appliedAt:$appliedAt,scope:$scope,registration:$registration}' \
    > "$active_tmp"
mv "$active_tmp" "$ACTIVE_STATE"
sync
printf 'Updated Traceknot to %s through Skills CLI at %s\n' "$RELEASE_TAG" "$REGISTRATION"
