#!/usr/bin/env bun
import { main as verifyMain } from "../system/cli/verify.ts";
import { main as storageMain } from "../system/cli/storage.ts";
import { main as boardMain } from "../system/cli/board.ts";

const command = process.argv[2];
if (command === "verify") process.exit(await verifyMain(process.argv.slice(3)));
if (command === "storage") process.exit(await storageMain(process.argv.slice(3)));
if (command === "board") process.exit(await boardMain(process.argv.slice(3)));
process.stderr.write("Usage: traceknot verify [options]\n       traceknot board update --input UPDATE.json --state-dir DIR [options]\n       traceknot storage status|prune|pin|unpin [options]\n");
process.exit(64);
