{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceknot.kyungho.info/schemas/self-hosting-parity-report.v1.json",
  "title": "Traceknot self-hosting cache parity and usage report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "requestId", "snapshotId", "verification", "cache", "usage"],
  "properties": {
    "schemaVersion": { "const": "self-hosting-parity-report/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "snapshotId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "qaVerdict", "runDigest", "verdictDigest"],
      "properties": {
        "state": { "const": "TERMINAL" },
        "qaVerdict": { "const": "PASS" },
        "runDigest": { "$ref": "#/$defs/digest" },
        "verdictDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "payloadDigest", "cold", "warm", "equal"],
      "properties": {
        "key": { "$ref": "#/$defs/digest" },
        "payloadDigest": { "$ref": "#/$defs/digest" },
        "cold": { "const": "MISS" },
        "warm": { "const": "HIT" },
        "equal": { "const": true }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runId",
        "requestId",
        "snapshotId",
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteTokens",
        "outputTokens",
        "reasoningTokens",
        "modelCalls",
        "cacheHitRate",
        "estimatedCost"
      ],
      "properties": {
        "schemaVersion": { "const": "usage-report/v1" },
        "runId": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "snapshotId": { "type": "string", "minLength": 1 },
        "inputTokens": { "$ref": "#/$defs/metric" },
        "cachedInputTokens": { "$ref": "#/$defs/metric" },
        "cacheWriteTokens": { "$ref": "#/$defs/metric" },
        "outputTokens": { "$ref": "#/$defs/metric" },
        "reasoningTokens": { "$ref": "#/$defs/metric" },
        "modelCalls": { "type": "integer", "minimum": 0 },
        "cacheHitRate": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "const": "unavailable" }
          ]
        },
        "estimatedCost": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": { "status": { "const": "unavailable" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "currency", "amount"],
              "properties": {
                "status": { "enum": ["estimated", "actual"] },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "amount": { "type": "number", "minimum": 0 }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metric": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "const": "unavailable" }
      ]
    }
  }
}
