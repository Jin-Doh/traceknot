{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceknot.kyungho.info/schemas/prose-quality-config.v1.json",
  "title": "Published prose quality configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enabled", "mode", "locales", "include", "exclude", "minimumProseCharacters", "maxChangeRate", "rejectChangeRate"],
  "properties": {
    "schemaVersion": { "const": "prose-quality-config/v1" },
    "enabled": { "type": "boolean" },
    "mode": { "enum": ["advisory", "blocking"] },
    "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ko", "en", "zh-Hans"] } },
    "localeOverrides": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "enum": ["ko", "en", "zh-Hans"] }
    },
    "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "exclude": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "minimumProseCharacters": { "type": "integer", "minimum": 1 },
    "maxChangeRate": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
    "rejectChangeRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
  }
}
