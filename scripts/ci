#!/bin/sh
# Canonical local and GitHub Actions quality gate.

set -eu

SELF_HOSTED_INNER=0
case ${1-} in
    "")
        ;;
    --self-hosted-inner)
        SELF_HOSTED_INNER=1
        shift
        ;;
    *)
        printf 'ci: unknown option: %s\n' "$1" >&2
        exit 2
        ;;
esac
if [ "$#" -ne 0 ]; then
    printf '%s\n' 'ci: --self-hosted-inner accepts no arguments' >&2
    exit 2
fi

ROOT=$(CDPATH= cd -P "$(dirname "$0")/.." && pwd)
cd "$ROOT"

EXPECTED_BUN=1.3.14
ACTUAL_BUN=$(bun --version)
if [ "$ACTUAL_BUN" != "$EXPECTED_BUN" ]; then
    printf 'ci: Bun %s required, found %s\n' "$EXPECTED_BUN" "$ACTUAL_BUN" >&2
    exit 2
fi

printf '%s\n' '==> locked dependencies'
bun install --frozen-lockfile --ignore-scripts

printf '%s\n' '==> dependency audit'
bun audit

printf '%s\n' '==> shell syntax and installer lifecycle'
sh -n install.sh uninstall.sh bin/traceknot-update scripts/package-release.sh \
    scripts/verify-published-release.sh tests/portable-installer-smoke.sh \
    tests/release-verifier-smoke.sh tests/skills-cli-smoke.sh \
    tests/updater-smoke.sh scripts/ci
sh tests/portable-installer-smoke.sh
sh tests/skills-cli-smoke.sh
sh tests/updater-smoke.sh
sh tests/release-verifier-smoke.sh

printf '%s\n' '==> JSON syntax'
git ls-files '*.json' | while IFS= read -r json_file; do
    JSON_FILE=$json_file bun -e 'JSON.parse(await Bun.file(process.env.JSON_FILE).text())'
done

printf '%s\n' '==> README localization contract'
bun scripts/check-readme-contract.ts
bun x --no-install tsc --ignoreConfig --noEmit --strict --types bun \
    --target ES2022 --module ESNext --moduleResolution Bundler \
    scripts/check-readme-contract.ts

printf '%s\n' '==> prompt-injection risk'
bun scripts/audit-prompt-injection.ts --threshold high

printf '%s\n' '==> published prose quality'
PROSE_REPORT_DIR=$(mktemp -d "${TMPDIR:-/tmp}/traceknot-prose.XXXXXX")
PROSE_REPORT=$PROSE_REPORT_DIR/report.json
trap 'rm -f "$PROSE_REPORT"; rmdir "$PROSE_REPORT_DIR"' EXIT HUP INT TERM
bun x --no-install ajv validate --spec=draft2020 \
    -s contracts/prose-quality-config.schema.json \
    -d prose-quality.config.json
bun scripts/audit-prose-quality.ts --config prose-quality.config.json --report "$PROSE_REPORT"
bun x --no-install ajv validate --spec=draft2020 \
    -s contracts/prose-quality-report.schema.json \
    -d "$PROSE_REPORT"

printf '%s\n' '==> tests and strict type checking'
bun run test
bun run typecheck

printf '%s\n' '==> canonical schemas and capability records'
# Compile the evaluation document with its published record contract registered;
# all other schemas remain independently self-contained.
for schema in contracts/*.schema.json; do
    if [ "$schema" = contracts/evidence-evaluation-document.schema.json ]; then
        bun x --no-install ajv compile --spec=draft2020 \
            -s "$schema" \
            -r contracts/evidence-evaluation.schema.json
    else
        bun x --no-install ajv compile --spec=draft2020 -s "$schema"
    fi
done
bun x --no-install ajv validate --spec=draft2020 \
    -s contracts/codeql-policy.schema.json \
    -d codeql-policy.json
bun x --no-install ajv validate --spec=draft2020 \
    -s contracts/capability-v2.schema.json \
    -d 'adapters/*/capability.json'

printf '%s\n' '==> whitespace integrity'
git diff --check

if [ "$SELF_HOSTED_INNER" -eq 0 ]; then
    printf '%s\n' '==> canonical self-hosting verification'
    bun scripts/self-verify.ts
fi

printf '%s\n' 'Traceknot CI gate: PASS'
