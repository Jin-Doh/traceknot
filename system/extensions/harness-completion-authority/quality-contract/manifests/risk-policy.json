  },
  "requiredBoundaryBehavior": [
    "-1 allows work/admission",
    "exact crosses boundary",
    "+1 crosses boundary",
    "queue equality fails global_deadline when runner not started",
    "global equality forbids start/recovery/commit",
    "lease expiry equals global deadline",
    "recovery cannot extend deadline"
  ],
  "globalCompletionFormula": "queueSlaMs + riskHardMs",
  "effectiveSoftFormula": "min(runnerSoftTotalMs, riskSoftMs)",
  "effectiveFinalHardFormula": "min(runnerHardTotalMs, riskHardMs, remainingGlobalMs)",
  "reserveHardFormula": "evidenceFlushHardMs + shutdownHardMs",
  "workDeadlineFormula": "runStart + effectiveWorkHardMs",
  "finalDeadlineFormula": "runStart + effectiveFinalHardMs"
}
