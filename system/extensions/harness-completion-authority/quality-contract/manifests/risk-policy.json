{
  "id": "gajae-code-risk-policy",
  "schemaVersion": "risk/v1",
  "policyId": "gajae-code-risk-policy",
  "defaultDecision": "BLOCK",
  "unknownRisk": "R3",
  "riskLevels": [
    "R0",
    "R1",
    "R2",
    "R3"
  ],
  "verificationProfiles": {
    "R0": {
      "required": [
        "existing-tests",
        "independent-smoke"
      ],
      "receiptAuthority": "local-evidence"
    },
    "R1": {
      "required": [
        "existing-tests",
        "independent-smoke"
      ],
      "receiptAuthority": "local-evidence"
    },
    "R2": {
      "required": [
        "sealed-snapshot",
        "independent-adversarial-test"
      ],
      "receiptAuthority": "independent-verifier"
    },
    "R3": {
      "required": [
        "sealed-snapshot",
        "independent-adversarial-test",
        "broker-receipt",
        "multi-approval",
        "managed-ci"
      ],
      "receiptAuthority": "managed-broker"
    }
  },
  "decisions": [
    "ALLOW",
    "REQUIRE_CONFIRMATION",
    "REQUIRE_APPROVAL",
    "BLOCK"
  ],
  "precedence": [
    {
      "rank": 0,
      "id": "hard-r3",
      "source": "hard-coded safety invariant",
      "effect": "force",
      "decision": "BLOCK",
      "risk": "R3"
    },
    {
      "rank": 1,
      "id": "managed-minimum",
      "source": "managed policy minimum",
      "effect": "raise-only",
      "minimumRisk": "R2"
    },
    {
      "rank": 2,
      "id": "approved-contract",
      "source": "approved contract artifact",
      "effect": "raise-only"
    },
    {
      "rank": 3,
      "id": "deterministic-detector",
      "source": "deterministic detector",
      "effect": "raise-only"
    },
    {
      "rank": 4,
      "id": "signed-organization-policy",
      "source": "signed organization policy",
      "effect": "raise-only"
    },
    {
      "rank": 5,
      "id": "project-hint",
      "source": "project hint",
      "effect": "raise-only",
      "mayLower": false
    },
    {
      "rank": 6,
      "id": "unknown",
      "source": "missing, malformed, or unsupported evidence",
      "effect": "force",
      "decision": "BLOCK",
      "risk": "R3"
    }
  ],
  "decisionTable": [
    {
      "id": "risk-hard-invariant",
      "when": {
        "hardInvariant": true
      },
      "result": {
        "risk": "R3",
        "decision": "BLOCK"
      }
    },
    {
      "id": "risk-unsupported",
      "when": {
        "unsupported": true
      },
      "result": {
        "risk": "R3",
        "decision": "BLOCK"
      }
    },
    {
      "id": "risk-unclassified",
      "when": {
        "classified": false
      },
      "result": {
        "risk": "R3",
        "decision": "BLOCK"
      }
    },
    {
      "id": "risk-managed-minimum",
      "when": {
        "managedMinimum": "R2"
      },
      "result": {
        "risk": "R2",
        "decision": "REQUIRE_APPROVAL"
      }
    },
    {
      "id": "risk-approved-contract",
      "when": {
        "approvedContract": true
      },
      "result": {
        "risk": "R1",
        "decision": "REQUIRE_CONFIRMATION"
      }
    },
    {
      "id": "risk-deterministic-detector",
      "when": {
        "detector": "deterministic"
      },
      "result": {
        "risk": "R1",
        "decision": "REQUIRE_CONFIRMATION"
      }
    },
    {
      "id": "risk-signed-policy",
      "when": {
        "signedOrganizationPolicy": true
      },
      "result": {
        "risk": "R1",
        "decision": "REQUIRE_CONFIRMATION"
      }
    },
    {
      "id": "risk-project-hint",
      "when": {
        "projectHint": true
      },
      "result": {
        "effect": "raise-only"
      }
    },
    {
      "id": "risk-safe",
      "when": {
        "classified": true,
        "risk": "R0"
      },
      "result": {
        "risk": "R0",
        "decision": "ALLOW"
      }
    }
  ],
  "mergeRule": {
    "name": "max-risk-then-most-restrictive-decision",
    "riskOrder": [
      "R0",
      "R1",
      "R2",
      "R3"
    ],
    "decisionOrder": [
      "ALLOW",
      "REQUIRE_CONFIRMATION",
      "REQUIRE_APPROVAL",
      "BLOCK"
    ],
    "unknownInputs": "BLOCK",
    "projectHints": "can only increase risk or restrict decision"
  },
  "invariants": [
    "No input may lower a previously selected risk or relax a decision.",
    "Unknown, malformed, stale, or unsupported states resolve to R3/BLOCK.",
    "A project hint is advisory and cannot authorize an operation.",
    "The selected result is deterministic for the same ordered evidence set."
  ],
  "phase1Authorized": false,
