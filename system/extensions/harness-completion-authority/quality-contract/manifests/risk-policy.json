  "phaseDeadlinePolicy": {
    "phaseOrder": [
      "bootstrap",
      "collection",
      "execution",
      "evidenceFlush",
      "shutdown"
    ],
    "allDurationsIntegerMs": true,
    "softFormula": "min(phaseStart + phaseSoftMs, optionalStopDeadline, workDeadline)",
    "hardFormula": "min(phaseStart + phaseHardMs, workDeadline)",
    "flushSoftFormula": "min(flushStart + flushSoftMs, flushHardDeadline)",
    "flushHardFormula": "min(flushStart + flushHardMs, finalDeadline - shutdownHardMs)",
    "shutdownSoftFormula": "min(shutdownStart + shutdownSoftMs, shutdownHardDeadline)",
    "shutdownHardFormula": "min(shutdownStart + shutdownHardMs, finalDeadline)",
    "boundary": "inclusive",
    "admission": "now < deadline",
    "crossing": "now >= deadline",
    "hardTimeoutDisposition": "non-CLEAR",
    "mandatoryNeverDropped": true,
    "optionalStopAtEquality": true
  },
  "restartPolicy": {
    "combinedUncertaintyMaxMs": 1000,
    "remainingFormula": "clamp(0, configuredDuration, earliestDeadline - latestNow)",
    "reconstructedDeadline": "min(persistedAbsoluteDeadline, currentWall + remaining, everyOuterCap)",
    "neverMovesLater": true,
    "lostChildDisposition": "cancel-reap-infrastructure-inconclusive"
  },
  "optionalStopPolicy": {
    "optionalAdmission": "now < optionalStopDeadline and estimate fits strictly before workDeadline",
    "equality": "stop-new-optional-work",
    "runningOptional": "may-finish",
    "mandatory": "continues-until-hard-policy",
    "hardTimeout": "never-CLEAR"
  },
  "retentionPolicy": {
    "mandatoryEvidence": "retain-durable-and-referenced",
    "failedPartialRuns": {
      "retainDays": 7
    },
    "importedEphemeral": {
      "removeAfterAck": true
    },
    "crossRunCache": "forbidden"
  },
  "profileCompatibility": {
    "g0-evidence-only": {
      "capability": "G0",
