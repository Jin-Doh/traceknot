{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceknot.kyungho.info/schemas/capability-model.v1.json",
  "title": "Traceknot shared host capability set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executeCommands",
    "executeBrowser",
    "captureArtifacts",
    "bindSnapshot",
    "provideIndependentEvidence",
    "persistEvidence",
    "approveExceptions",
    "isolatedReadOnlyReview",
    "enforcedStructuredOutput"
  ],
  "properties": {
    "executeCommands": { "type": "boolean" },
    "executeBrowser": { "type": "boolean" },
    "captureArtifacts": { "type": "boolean" },
    "bindSnapshot": { "type": "boolean" },
    "provideIndependentEvidence": { "type": "boolean" },
    "persistEvidence": { "type": "boolean" },
    "approveExceptions": { "type": "boolean" },
    "isolatedReadOnlyReview": { "type": "boolean" },
    "enforcedStructuredOutput": { "type": "boolean" }
  }
}
