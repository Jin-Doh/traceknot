{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceknot.kyungho.info/schemas/capability.v2.json",
  "title": "Traceknot host capability v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "host", "adapterVersion", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "quality-capability/v2" },
    "host": { "type": "string", "minLength": 1 },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "capabilities": {
      "$ref": "https://traceknot.kyungho.info/schemas/capability-model.v1.json"
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
