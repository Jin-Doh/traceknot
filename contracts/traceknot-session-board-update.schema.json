{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceknot.kyungho.info/schemas/traceknot-session-board-update.v1.json",
  "title": "Traceknot session Board update",
  "$comment": "This schema is the closed structural contract. parseSessionBoardUpdate is the canonical semantic validator for aggregate and cross-field invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "sessionHost", "generatedAt", "view"],
  "properties": {
    "schemaVersion": { "const": "traceknot-session-board-update/v1" },
    "sessionId": { "type": "string", "minLength": 8, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "sessionHost": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "generatedAt": { "type": "string", "minLength": 20, "maxLength": 64, "pattern": "^\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2\\d))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?Z$" },
    "invocationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "view": { "$ref": "https://traceknot.kyungho.info/schemas/qa-board-view.v1.json" }
  }
}
