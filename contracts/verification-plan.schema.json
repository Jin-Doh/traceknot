{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceknot.kyungho.info/schemas/verification-plan.v1.json",
  "title": "Verification plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "snapshotId", "risks", "conditions", "obligations"],
  "properties": {
    "schemaVersion": { "const": "verification-plan/v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "snapshotId": { "type": "string", "minLength": 1 },
    "risks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "level", "impact", "likelihood", "basisIds", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "level": { "enum": ["R0", "R1", "R2", "R3"] },
          "impact": { "type": "integer", "minimum": 1, "maximum": 4 },
          "likelihood": { "type": "integer", "minimum": 1, "maximum": 4 },
          "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conditions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "basisIds", "riskIds", "techniques", "expectedResult"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "riskIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "techniques": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "expectedResult": { "type": "string", "minLength": 1 }
        }
      }
    },
    "obligations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "conditionIds", "evidenceType", "mandatory", "independence", "entryCriteria", "completionCriteria"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "conditionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "evidenceType": { "enum": ["experiment", "test-result", "browser-result", "build-result", "static-analysis", "review", "approval", "scenario-result"] },
          "mandatory": { "type": "boolean" },
          "independence": { "enum": ["self-check", "separate-verification-context", "independent-producer", "external-approval"] },
          "entryCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "completionCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "visualCompositionRequirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "requestId", "snapshotId", "conditionId", "scopeDecision", "basisIds", "requiredCaptures", "viewports", "minimumIndependence"],
            "properties": {
              "schemaVersion": { "const": "visual-composition-requirement/v1" },
              "requestId": { "type": "string", "minLength": 1 },
              "snapshotId": { "type": "string", "minLength": 1 },
              "conditionId": { "type": "string", "minLength": 1 },
              "scopeDecision": { "enum": ["required", "unknown"] },
              "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "requiredCaptures": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["surfaceId", "stateId", "viewportId"],
                  "properties": {
                    "surfaceId": { "type": "string", "minLength": 1 },
                    "stateId": { "type": "string", "minLength": 1 },
                    "viewportId": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "viewports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "width", "height"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "width": { "type": "number", "exclusiveMinimum": 0 },
                    "height": { "type": "number", "exclusiveMinimum": 0 },
                    "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 },
                    "label": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "minimumIndependence": { "enum": ["self-check", "separate-verification-context", "independent-producer", "external-approval"] }
            }
          },
          "uiResilienceRequirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "requestId", "snapshotId", "conditionId", "scopeDecision", "basisIds", "requiredRuns", "viewports", "applicabilityApprovals", "unknownApplicabilityKeys", "minimumIndependence"],
            "properties": {
              "schemaVersion": { "const": "ui-resilience-requirement/v1" },
              "requestId": { "type": "string", "minLength": 1 },
              "snapshotId": { "type": "string", "minLength": 1 },
              "conditionId": { "type": "string", "minLength": 1 },
              "scopeDecision": { "enum": ["required", "unknown"] },
              "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "requiredRuns": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["surfaceId", "stateId", "viewportId", "profile", "fixtureId", "fixtureContentDigest", "regions"],
                  "properties": {
                    "surfaceId": { "type": "string", "minLength": 1 },
                    "stateId": { "type": "string", "minLength": 1 },
                    "viewportId": { "type": "string", "minLength": 1 },
                    "profile": { "enum": ["text-overflow", "resize-text-200", "reflow-320", "text-spacing-wcag", "pseudo-localization", "rtl", "reduced-motion", "hover-focus-content"] },
                    "fixtureId": { "type": "string", "minLength": 1 },
                    "fixtureContentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "regions": {
                      "type": "array", "minItems": 1,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["regionId", "policy", "basisIds"],
                        "properties": {
                          "regionId": { "type": "string", "minLength": 1 },
                          "policy": { "enum": ["no-overflow", "wrap", "scroll-x", "truncate-with-access"] },
                          "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                          "maxLines": { "type": "integer", "minimum": 1 }
                        },
                        "allOf": [
                          { "if": { "properties": { "policy": { "const": "truncate-with-access" } }, "required": ["policy"] }, "then": { "properties": { "maxLines": true }, "required": ["maxLines"] }, "else": { "properties": { "maxLines": false } } }
                        ]
                      }
                    }
                  }
                }
              },
              "viewports": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "width", "height"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "width": { "type": "number", "exclusiveMinimum": 0 },
                    "height": { "type": "number", "exclusiveMinimum": 0 },
                    "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 },
                    "label": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "applicabilityApprovals": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["requestId", "snapshotId", "conditionId", "surfaceId", "profile", "basisIds", "rationale", "approvalReceipt", "approvalArtifactDigest"],
                  "properties": {
                    "requestId": { "type": "string", "minLength": 1 },
                    "snapshotId": { "type": "string", "minLength": 1 },
                    "conditionId": { "type": "string", "minLength": 1 },
                    "surfaceId": { "type": "string", "minLength": 1 },
                    "profile": { "enum": ["text-overflow", "resize-text-200", "reflow-320", "text-spacing-wcag", "pseudo-localization", "rtl", "reduced-motion", "hover-focus-content"] },
                    "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                    "rationale": { "type": "string", "minLength": 1 },
                    "approvalReceipt": {
                      "type": "object", "additionalProperties": false,
                      "required": ["schemaVersion", "receiptId", "issuer", "keyId", "requestId", "snapshotId", "conditionId", "surfaceId", "profile", "basisIds", "rationale", "signature"],
                      "properties": {
                        "schemaVersion": { "const": "ui-applicability-approval-receipt/v1" },
                        "receiptId": { "type": "string", "minLength": 1 },
                        "issuer": { "type": "string", "minLength": 1 },
                        "keyId": { "type": "string", "minLength": 1 },
                        "requestId": { "type": "string", "minLength": 1 },
                        "snapshotId": { "type": "string", "minLength": 1 },
                        "conditionId": { "type": "string", "minLength": 1 },
                        "surfaceId": { "type": "string", "minLength": 1 },
                        "profile": { "enum": ["text-overflow", "resize-text-200", "reflow-320", "text-spacing-wcag", "pseudo-localization", "rtl", "reduced-motion", "hover-focus-content"] },
                        "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                        "rationale": { "type": "string", "minLength": 1 },
                        "signature": { "type": "string", "minLength": 1 }
                      }
                    },
                    "approvalArtifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                  }
                }
              },
              "unknownApplicabilityKeys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "minimumIndependence": { "enum": ["self-check", "separate-verification-context", "independent-producer", "external-approval"] }
            }
          }
        }
      }
    }
  }
}
