{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceknot.kyungho.info/schemas/verification-plan.v1.json",
  "title": "Verification plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "snapshotId", "risks", "conditions", "obligations"],
  "properties": {
    "schemaVersion": { "const": "verification-plan/v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "snapshotId": { "type": "string", "minLength": 1 },
    "risks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "level", "impact", "likelihood", "basisIds", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "level": { "enum": ["R0", "R1", "R2", "R3"] },
          "impact": { "type": "integer", "minimum": 1, "maximum": 4 },
          "likelihood": { "type": "integer", "minimum": 1, "maximum": 4 },
          "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conditions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "basisIds", "riskIds", "techniques", "expectedResult"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "riskIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "techniques": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "expectedResult": { "type": "string", "minLength": 1 }
        }
      }
    },
    "obligations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "conditionIds", "evidenceType", "mandatory", "independence", "entryCriteria", "completionCriteria"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "conditionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "evidenceType": { "enum": ["experiment", "test-result", "browser-result", "build-result", "static-analysis", "review", "approval", "scenario-result"] },
          "mandatory": { "type": "boolean" },
          "independence": { "enum": ["self-check", "separate-verification-context", "independent-producer", "external-approval"] },
          "entryCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "completionCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "visualCompositionRequirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "requestId", "snapshotId", "conditionId", "scopeDecision", "basisIds", "requiredCaptures", "viewports", "minimumIndependence"],
            "properties": {
              "schemaVersion": { "const": "visual-composition-requirement/v1" },
              "requestId": { "type": "string", "minLength": 1 },
              "snapshotId": { "type": "string", "minLength": 1 },
              "conditionId": { "type": "string", "minLength": 1 },
              "scopeDecision": { "enum": ["required", "unknown"] },
              "basisIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "requiredCaptures": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["surfaceId", "stateId", "viewportId"],
                  "properties": {
                    "surfaceId": { "type": "string", "minLength": 1 },
                    "stateId": { "type": "string", "minLength": 1 },
                    "viewportId": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "viewports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "width", "height"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "width": { "type": "number", "exclusiveMinimum": 0 },
                    "height": { "type": "number", "exclusiveMinimum": 0 },
                    "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 },
                    "label": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "minimumIndependence": { "enum": ["self-check", "separate-verification-context", "independent-producer", "external-approval"] }
            }
          }
        }
      }
    }
  }
}
